APP_ENV=testing
APP_KEY=

TENANT_ID=1

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elimbar_testing
# Тесты подключаются владельцем схемы (миграции + append-only/RLS
# констрейнты создаются этой ролью) — RLS-политики всё равно применяются
# ко всем ролям, кроме суперюзера/владельца в некоторых сценариях, поэтому
# для тестов самих RLS-политик (contour A/B изоляция) используйте
# DB_STAFF_*/DB_PUBLIC_* ниже вместо DB_USERNAME.
DB_USERNAME=elimbar_owner
DB_PASSWORD=elimbar_owner

DB_STAFF_USERNAME=elimbar_staff
DB_STAFF_PASSWORD=elimbar_staff
DB_PUBLIC_USERNAME=elimbar_public
DB_PUBLIC_PASSWORD=elimbar_public

MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
CACHE_STORE=array
