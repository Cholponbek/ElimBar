APP_NAME=ElimBar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DOMAIN=localhost

APP_LOCALE=ky
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

TENANT_ID=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL ------------------------------------------------------------
# DB_USERNAME/DB_PASSWORD — владелец схемы (app_owner), только для миграций
# и деплоя. Приложение НЕ подключается этой ролью в runtime — см.
# DB_STAFF_*/DB_PUBLIC_* и config/database.php (pgsql_staff / pgsql_public),
# ARCHITECTURE.md §4 (мультитенантность) и §5 (RLS-разделение A/B).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=elimbar
DB_USERNAME=elimbar_owner
DB_PASSWORD=

# Контур B (Filament, домен, Horizon-джобы) — роль app_staff: видит
# beneficiaries и приватные колонки cases, но всё ещё под RLS tenant_isolation.
DB_STAFF_USERNAME=elimbar_staff
DB_STAFF_PASSWORD=

# Контур A (публичная витрина, донат, автоотчёт) — роль app_public:
# физически не видит beneficiaries и приватные колонки cases (RLS + REVOKE
# на уровне Postgres, не фильтр в контроллере).
DB_PUBLIC_USERNAME=elimbar_public
DB_PUBLIC_PASSWORD=

# --- Сессии/очереди/кэш через Redis + Horizon -------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- MinIO (приватный бакет для proofs, S3-совместимый) ---------------------
# Публичного бакета для подтверждающих документов нет и не будет — чеки
# содержат ФИО и суммы (ARCHITECTURE.md §7).
FILESYSTEM_DISK=proofs
MINIO_ROOT_USER=elimbar
MINIO_ROOT_PASSWORD=
AWS_ACCESS_KEY_ID="${MINIO_ROOT_USER}"
AWS_SECRET_ACCESS_KEY="${MINIO_ROOT_PASSWORD}"
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=elimbar-proofs
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=

# --- Платежи: Finik (эквайринг, acquiring.averspay.kg) -------------------
# PAYMENT_PROVIDER=null резолвит PaymentGateway::class в NullPaymentGateway
# (заглушку). finik подключает FinikPaymentGateway — см. AppServiceProvider.
#
# FINIK_PRIVATE_KEY_BASE64 — наш приватный ключ (публичная половина уже
# передана Finik по почте отдельно), base64 от PEM-файла ЦЕЛИКОМ:
#   base64 -w0 finik-private.pem
# Так надёжнее многострочного PEM в .env — см. историю правок APP_KEY на
# проде, где ручной ввод в консоли хостера обрезал переносы строк.
#
# FINIK_WEBHOOK_PUBLIC_KEY_BASE64 — ключ САМОГО Finik (не наш), которым
# проверяется подпись входящих вебхуков. На момент написания ещё не
# получен от Finik отдельным письмом — пока пусто, verifyWebhookSignature()
# всегда вернёт false и донаты не будут подтверждаться по вебхуку.
PAYMENT_PROVIDER=null
PAYMENT_WEBHOOK_SECRET=
FINIK_BASE_URL=https://beta.api.acquiring.averspay.kg
FINIK_ACCOUNT_ID=
FINIK_API_KEY=
FINIK_PRIVATE_KEY_BASE64=
FINIK_WEBHOOK_PUBLIC_KEY_BASE64=
FINIK_WEBHOOK_URL="${APP_URL}/webhooks/finik"
FINIK_MERCHANT_NAME="Элим, барсыңбы?!"

# --- SMS -----------------------------------------------------------------
# Только OTP-логин донора. Чек по донату и напоминания — email/push/
# Telegram, не SMS (ARCHITECTURE.md §8) — SMS в КР платные, дороже самого
# доната в 10 сом/день.
SMS_PROVIDER=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@elimbar.kg"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
